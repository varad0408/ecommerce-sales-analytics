  <worksheets>
    <worksheet name='Average Delivery Time'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Avg Delivery</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='df_Customers' name='federated.0pvt8i416tqwp71g5cv5w1izjgf9' />
          </datasources>
          <datasource-dependencies datasource='federated.0pvt8i416tqwp71g5cv5w1izjgf9'>
            <column caption='Average Delivery Time' datatype='integer' name='[Calculation_0657830684037128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [order_purchase_date],&#13;&#10;    [order_delivered_date]&#13;&#10;)' />
            </column>
            <column-instance column='[Calculation_0657830684037128]' derivation='Avg' name='[avg:Calculation_0657830684037128:qk]' pivot='key' type='quantitative' />
            <column caption='Order Delivered Date' datatype='date' name='[order_delivered_date]' role='dimension' type='ordinal' />
            <column caption='Order Purchase Date' datatype='date' name='[order_purchase_date]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='18' />
            <format attr='font-weight' value='bold' />
          </style-rule>
          <style-rule element='title'>
            <format attr='font-size' value='12' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0pvt8i416tqwp71g5cv5w1izjgf9].[avg:Calculation_0657830684037128:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
