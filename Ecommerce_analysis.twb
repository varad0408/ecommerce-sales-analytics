      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='real' default-format='*0.00,, &quot;M&quot;' name='[Calculation_0657827198840832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([price]) + SUM([shipping_charges])) / 1000000' />
      </column>
      <column caption='Total Sales' datatype='real' default-format='*0.00,,&quot;M&quot;' name='[Calculation_0657827200610305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([price]) / 1000000,2)' />
      </column>
      <column caption='Average Order Value' datatype='real' default-format='*0.00' name='[Calculation_0657827205058563]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([price]) / COUNTD([order_id])' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_0657827212812292]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='&quot;Brazil&quot;' />
      </column>
      <column caption='Late Order Flag' datatype='integer' name='[Calculation_0657830682263557]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF NOT ISNULL([order_delivered_date])&#13;&#10;AND [order_delivered_date] &gt; [order_estimated_delivery_date]&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='On-Time Order Flag' datatype='integer' name='[Calculation_0657830683738119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([order_delivered_date])&#13;&#10;AND [order_delivered_date] &lt;= [order_estimated_delivery_date]&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Average Delivery Time' datatype='integer' name='[Calculation_0657830684037128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [order_purchase_date],&#13;&#10;    [order_delivered_date]&#13;&#10;)' />
      </column>
      <column caption='Delivery Order Flag' datatype='integer' name='[Calculation_0657830684368905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([order_delivered_date])&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
